{
    "createProductboardNote": {
      "schema": {
        "method": "POST",
        "host": "api.productboard.com",
        "path": "/v2/notes",
        "headers": {
            "Authorization": "Bearer <%= iparam.pb_access_token %>",
            "Content-Type": "application/json"
        }
      }
    },
    "createProductboardTag": {
      "schema": {
        "method": "POST",
        "host": "api.productboard.com",
        "path": "/v2/entities/fields/tags/values",
        "headers": {
            "Authorization": "Bearer <%= iparam.pb_access_token %>",
            "Content-Type": "application/json"
        }
      }
    },
    "createProductboardUser": {
      "schema": {
        "method": "POST",
        "host": "api.productboard.com",
        "path": "/v2/entities",
        "headers": {
            "Authorization": "Bearer <%= iparam.pb_access_token %>",
            "Content-Type": "application/json"
        }
      }
    },
    "getTicketConversation": {
        "schema": {
            "protocol": "https",
            "method": "GET",
            "host": "<%= iparam.subdomain %>.freshdesk.com",
            "path": "/api/v2/tickets/<%= context.query %>/conversations?page=<%= context.page %>",
            "headers": {
                "Authorization": "Basic <%= encode(iparam.api_key) %>",
                "Content-Type": "application/json"
            }
        }
    }
}